{
  "private": true,
  "name": "vault-tectradingco",
  "description": "The trading karma bot of r/Fallout76Marketplace, as a Reddit Devvit app",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-Fallout76Marketplace/fo76-karma-devvit.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "devvit playtest",
    "lint": "eslint src",
    "login": "devvit login",
    "logs": "devvit logs Fallout76Marketplace",
    "release": "devvit publish",
    "prettier": "prettier --write .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "type-check": "tsc --build",
    "verify": "prettier --check . && npm run type-check && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.4",
    "@devvit/web": "0.15.4",
    "@hono/node-server": "^2.0.3",
    "devvit": "0.15.4",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "ajv": "6.15.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  }
}
